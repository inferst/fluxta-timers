{
  "name": "timers",
  "title": "Timers",
  "description": "Countdown timers that fire Events, and stopwatches that count across pauses",
  "version": "0.1.0",
  "author": "Mikhail Morozov",
  "license": "MIT",
  "homepage": "https://github.com/inferst/fluxta-timers",
  "repository": "https://github.com/inferst/fluxta-timers",
  "maintainers": ["inferst"],
  "minAppVersion": "0.1.0",
  "platforms": ["windows", "macos", "linux"],
  "categories": ["utilities", "streaming"],
  "apiVersion": 1,
  "main": "index.mjs",
  "icon": "icons/timer.svg",
  "editor": "editor/plugin.html",
  "editorPlacement": "settings",
  "actions": [
    {
      "name": "Start Stopwatch",
      "type": "start-stopwatch",
      "icon": "icons/play.svg",
      "context": "standalone",
      "editor": "editor/stopwatch.html"
    },
    {
      "name": "Pause Stopwatch",
      "type": "pause-stopwatch",
      "icon": "icons/pause.svg",
      "context": "standalone",
      "editor": "editor/stopwatch.html",
      "produces": [
        {
          "key": "elapsed",
          "name": "Elapsed",
          "type": "string"
        },
        {
          "key": "elapsedWords",
          "name": "Elapsed in Words",
          "type": "string"
        },
        {
          "key": "elapsedSeconds",
          "name": "Elapsed Seconds",
          "type": "number"
        }
      ]
    },
    {
      "name": "Reset Stopwatch",
      "type": "reset-stopwatch",
      "icon": "icons/timer-reset.svg",
      "context": "standalone",
      "editor": "editor/stopwatch.html",
      "produces": [
        {
          "key": "elapsed",
          "name": "Elapsed",
          "type": "string"
        },
        {
          "key": "elapsedWords",
          "name": "Elapsed in Words",
          "type": "string"
        },
        {
          "key": "elapsedSeconds",
          "name": "Elapsed Seconds",
          "type": "number"
        }
      ]
    },
    {
      "name": "Read Stopwatch",
      "type": "read-stopwatch",
      "icon": "icons/clock.svg",
      "context": "standalone",
      "editor": "editor/stopwatch.html",
      "produces": [
        {
          "key": "elapsed",
          "name": "Elapsed",
          "type": "string"
        },
        {
          "key": "elapsedWords",
          "name": "Elapsed in Words",
          "type": "string"
        },
        {
          "key": "elapsedSeconds",
          "name": "Elapsed Seconds",
          "type": "number"
        }
      ]
    }
  ],
  "sources": [
    {
      "key": "stopwatchState",
      "name": "Stopwatch State",
      "type": "string",
      "resolve": "query",
      "params": [
        {
          "key": "stopwatch",
          "name": "Stopwatch",
          "editor": "select",
          "options": "stopwatches"
        }
      ],
      "operand": {
        "editor": "select",
        "options": "stopwatchStates"
      }
    }
  ]
}
